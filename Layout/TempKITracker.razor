@using FeTracker.Common.Enums
@using FeTracker.Common.Helpers
@using FeTracker.Common.Icons
@using FeTracker.Common.RazorComponents

@inject TrackerNotifier notifier

<div class="tracker-grid">
    @for (var i = 0; i < Icons.Count(); i++)
    {
        var internalIndex = i;
        <TempClickable Icon=Icons[internalIndex] />
    }
    <section class="Count">@Count</section>
</div>

<button class="@(HideReset ? "hidden" : "")" @onclick="@Refresh">Refresh</button>

@code {
    /// <summary>
    /// Set to true if using a global reset button or an automated data reset of some fashion.
    /// </summary>
    [Parameter]
    public bool HideReset { get; set; }
    List<TempKeyItemIcon> Icons = [];
    int Count = 0;
    string _version = string.Empty;

    protected override void OnInitialized()
    {
        Icons.AddRange(Enum.GetValues<KeyItem>().Select(x => new TempKeyItemIcon(x)));

        notifier.RegisterCallback(TrackerEvent.Reset, new(this, Refresh));
        notifier.RegisterCallback(TrackerEvent.KeyItemUpdated, new(this, UpdateCount));
        notifier.RegisterCallback(TrackerEvent.RomUpdated, new(this, HandleRomUpdated));
        notifier.RegisterCallback(TrackerEvent.ObjectivesSet, new(this, OnObjectivesSet));
        base.OnInitialized();
    }

    //This entire method is awkward with the current architecture. Maybe I do eventually move the AppState object to this package, since if anyone else wants to build an app, they'll probably do the same/same-ish things
    //or they can just not use my appstate and use other things?
    private void HandleRomUpdated(StatePropertyChangedArgs args)
    {
        //We're only operating on actual values
        if(args.Value is null) return;

        //This is a little awkward, since I've been trying to keep the AppState something each dev wants to create on their own, but I still have a need to know about the Version specifically for the Pass.
        if (args.PropertyName == "Version" && args.Value?.GetType() == typeof(string))
            _version = (string)args.Value;

        //The AppState in the application should only publish a ROM Updated event when the loaded ROM is FE
        if (args.PropertyName == "RomFileName")
            Refresh();
    }

    public void OnObjectivesSet(StatePropertyChangedArgs args)
    {
        var objectives = args.Value as List<string> ?? [];
        objectives.ForEach(x => Console.WriteLine(x));
        Icons = [];
        Icons = Enum.GetValues<KeyItem>().Select(x => new TempKeyItemIcon(x)).ToList();
        StateHasChanged();
    }

    private void Refresh()
    {
        Icons = [];
        foreach (KeyItem iconType in Enum.GetValues<KeyItem>())
        {
            Icons.Add(new TempKeyItemIcon(iconType));
        }
        UpdateCount();
        StateHasChanged();
    }

    private void UpdateCount()
    {
        //current architecture makes very early FE seeds not reliably determine if the Pass is a KI well
        //Given how few of those seeds are probably played, this is not an issue worth tackling.
        Count = _version.StartsWith("v5.")
        ? Icons.Count(x => x.State != IconState.Gray)
        : Icons.Count(x => x.Icon != KeyItem.Pass && x.State != IconState.Gray);
    }
}
