@using FeTracker.AutoTrack.Sni.Services
@using sni;
@using static sni.DevicesResponse.Types;
@inject DeviceService DeviceService


<button @onclick="Connect" class="nf @ConnectionClass"></button>


@if (_connectedDevices != null && string.IsNullOrEmpty(AppState.Uri))
{
    <div>Select Device:</div>
    <select @onchange="SelectedDeviceChanged">
        <option value="" disabled selected> -- Select -- </option>
        @foreach (var device in _connectedDevices)
        {
            <option value="@device">@device.DisplayName</option>
        }
    </select>
}

<p>@ErrorMessage</p>

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();
    private string? ErrorMessage;
    private List<Device>? _connectedDevices;
    string ConnectionClass = "nf-md-power_plug_off";

    public async Task Connect()
    {
        DevicesResponse connectedDevices = new();

        try
        {
            connectedDevices = await DeviceService.GetDevicesListAsync() ?? connectedDevices;
        }
        catch (NullReferenceException)
        {
            ErrorMessage = "Unable to connect to SNI. Please make sure it's running";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }

        if (connectedDevices.Devices.Count >= 1)
        {
            var connectedDevice = connectedDevices.Devices.First();
            SetSelectedDevice(connectedDevice);
        }
        //Eventually re-allow support for selecting among multiple devices that are connected to SNI
        @* else if (connectedDevices?.Devices.Count > 1)
        {
            _connectedDevices = connectedDevices.Devices.First();
        } *@
        else
        {
            ErrorMessage = "No Devices found";
        }
    }

    private void SetSelectedDevice(Device device)
    {
        AppState.Uri = device.Uri;
        AppState.DeviceName = device.DisplayName;
        ConnectionClass = "nf-md-power_plug";
    }

    private void SelectedDeviceChanged(ChangeEventArgs e)
    {
        if (e is not null && e.Value is not null)
        {
            if (e.Value is Device)
            {
                var device = (Device)e.Value;
                SetSelectedDevice(device);
            }
        }
    }
}
