@using System.Text
@using FeTracker.Sni.Extensions
@using FeTracker.Sni.Services
@using sni;
@using static sni.DevicesResponse.Types;
@inject DeviceService DeviceService
@implements IDisposable


@* <button @onclick="Connect" class="nf @ConnectionClass"></button> *@
<div class="nf @ConnectionClass"></div>


@* @if (_connectedDevices != null && string.IsNullOrEmpty(AppState.Uri))
{
    <div>Select Device:</div>
    <select @onchange="SelectedDeviceChanged">
        <option value="" disabled selected> -- Select -- </option>
        @foreach (var device in _connectedDevices)
        {
            <option value="@device">@device.DisplayName</option>
        }
    </select>
} *@

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();
    @* private List<Device>? _connectedDevices; *@
    string ConnectionClass = "nf-md-power_plug_off";

    System.Timers.Timer _timer = new System.Timers.Timer(5000);

    protected override Task OnInitializedAsync()
    {
        _timer.Elapsed += async (sender, e) => await TimerElapsed();
        _timer.Start();
        return base.OnInitializedAsync();
    }

    async Task TimerElapsed()
    {
        await Connect();
    }

    public async Task Connect()
    {
        DevicesResponse connectedDevices = new();

        try
        {
            connectedDevices = await DeviceService.GetDevicesListAsync() ?? connectedDevices;
            if (connectedDevices.Devices.Count >= 1)
            {
                var connectedDevice = connectedDevices.Devices.First();
                SetSelectedDevice(connectedDevice);
            }
            //Eventually re-allow support for selecting among multiple devices that are connected to SNI
            @* else if (connectedDevices?.Devices.Count > 1)
            {
                _connectedDevices = connectedDevices.Devices.First();
            } *@
            else
            {
                AppState.ConnectionError = "No Devices found";
            }

            await GetDeviceInfo();
        }
        catch (NullReferenceException)
        {
            AppState.ConnectionError = "Unable to connect to SNI. Please make sure it's running";
        }
        catch (Exception ex)
        {
            AppState.ConnectionError = ex.Message;
        }
    }

    private void SetSelectedDevice(Device device)
    {
        AppState.Uri = device.Uri;
        AppState.DeviceName = device.DisplayName;
        ConnectionClass = "nf-md-power_plug";
    }

    private async Task GetDeviceInfo()
    {
        if (string.IsNullOrWhiteSpace(AppState.Uri))
            return;

        var infoClient = new DeviceInfo.DeviceInfoClient(AppState.Channel);
        var response = await infoClient.FetchFieldsRetryAsync(AppState.Uri, Field.DeviceName, Field.DeviceStatus,
Field.DeviceVersion, Field.RomFileName, Field.RomHashType, Field.RomHashValue);

        if (response.Success && response.Data is not null)
        {
            AppState.ConnectionError = string.Empty;

            if (response.Data.TryGetValue(Field.RomFileName, out var fieldValue))
            {
                AppState.RomFileName = fieldValue;
            }
        }
        else
        {
            AppState.ConnectionError = response.ErrorMessage;
        }

        if (AppState.RomFileName.EndsWith(".bin")) return;
        var stuff = new DeviceMemory.DeviceMemoryClient(AppState.Channel);
        var resp = await stuff.MappingDetectAsync(new DetectMemoryMappingRequest(new DetectMemoryMappingRequest
        {
            Uri = AppState.Uri
        }));

        
        @* var paste = Encoding.UTF8.GetString(resp.RomHeader00FFB0.Span.Slice(0x10, 21));
        Console.WriteLine(paste); *@
        var headerString = resp.RomHeader00FFB0.ToStringUtf8();
        Console.WriteLine(headerString);

    }

    private void SelectedDeviceChanged(ChangeEventArgs e)
    {
        if (e is not null && e.Value is not null)
        {
            if (e.Value is Device)
            {
                var device = (Device)e.Value;
                SetSelectedDevice(device);
            }
        }
    }

    

    public void Dispose()
    {
        _timer.Dispose();
    }
}
