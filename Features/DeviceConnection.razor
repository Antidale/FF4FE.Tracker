@using FeTracker.Sni.Extensions
@using FeTracker.Sni.Services
@using Grpc.Core
@using sni
@using static sni.DevicesResponse.Types
@inject DeviceService DeviceService
@inject TrackerNotifier trackerNotifier
@implements IDisposable

<div class="nf @ConnectionClass"></div>

@* TODO: rework this when you get around to supporting a selection from multiple available devices *@
@* @if (_connectedDevices != null && string.IsNullOrEmpty(AppState.Uri))
{
    <div>Select Device:</div>
    <select @onchange="SelectedDeviceChanged">
        <option value="" disabled selected> -- Select -- </option>
        @foreach (var device in _connectedDevices)
        {
            <option value="@device">@device.DisplayName</option>
        }
    </select>
} *@

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();
    @* private List<Device>? _connectedDevices; *@
    string ConnectionClass = "nf-md-power_plug_off";

    System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await SetupTimerAsync();
        trackerNotifier.RegisterCallback(FeTracker.Common.Enums.TrackerEvent.SettingUpdated, new(this, HandlePollingUpdated));
        await base.OnInitializedAsync();
    }

    async Task HandlePollingUpdated(StatePropertyChangedArgs args)
    {
        if (args.PropertyName != nameof(AppState.PollingFrequency))
        { return; }
        _timer?.Stop();
        _timer?.Elapsed -= async (sender, e) => await TimerElapsed();
        await SetupTimerAsync();
    }

    async Task SetupTimerAsync()
    {
        _timer = new System.Timers.Timer(TimeSpan.FromSeconds(AppState.PollingFrequency));
        _timer.Elapsed += async (sender, e) => await TimerElapsed();
        _timer.Start();
    }

    async Task TimerElapsed()
    {
        Console.WriteLine($"{DateTime.Now}: connecting");
        await Connect();
    }

    async Task Connect()
    {

        if (!AppState.ShouldReadMetadata)
        {
            return;
        }

        DevicesResponse connectedDevices = new();

        if (string.IsNullOrEmpty(AppState.DeviceName))
        {
            try
            {
                connectedDevices = await DeviceService.GetDevicesListAsync() ?? connectedDevices;
                if (connectedDevices.Devices.Count >= 1)
                {
                    var connectedDevice = connectedDevices.Devices.First();
                    SetSelectedDevice(connectedDevice);
                }
                //Eventually re-allow support for selecting among multiple devices that are connected to SNI
                @* else if (connectedDevices?.Devices.Count > 1)
            {
                _connectedDevices = connectedDevices.Devices.First();
            } *@
                else
                {
                    AppState.ConnectionError = "No devices connected to SNI";
                }

                await GetDeviceInfo();
            }
            catch (RpcException)
            {
                AppState.ConnectionError = "Unable to connect to SNI. Please make sure it's running, or adjust Host/Port settings.";
            }
            catch (Exception ex)
            {
                AppState.ConnectionError = ex.Message;
            }
        }
        else
        {
            await GetDeviceInfo();
        }
    }

    private void SetSelectedDevice(Device device)
    {
        AppState.Uri = device.Uri;
        AppState.DeviceName = device.DisplayName;
        ConnectionClass = "nf-md-power_plug";
    }

    private async Task GetDeviceInfo()
    {
        if (string.IsNullOrWhiteSpace(AppState.Uri))
            return;

        var infoClient = new DeviceInfo.DeviceInfoClient(AppState.Channel);
        var response = await infoClient.FetchFieldsRetryAsync(AppState.Uri,
                                Field.DeviceName, Field.RomFileName);

        if (!response.Success || response.Data is null)
        {
            AppState.ConnectionError = response.ErrorMessage;
            return;
        }

        AppState.ConnectionError = string.Empty;

        if (response.Data.TryGetValue(Field.RomFileName, out var romName))
        {
            if (!romName.EndsWith(".bin"))
            {
                await SetRomHeader();
            }

            AppState.RomFileName = romName;
        }

        if (response.Data.TryGetValue(Field.DeviceName, out var deviceName))
        {
            AppState.DeviceName = deviceName;
        }
    }

    private async Task SetRomHeader()
    {
        var dmc = new DeviceMemory.DeviceMemoryClient(AppState.Channel);
        var resp = await dmc.MappingDetectAsync(new DetectMemoryMappingRequest(new DetectMemoryMappingRequest
        {
            Uri = AppState.Uri
        }));

        AppState.RomHeader00FFB0 = resp.RomHeader00FFB0;
    }

    private void SelectedDeviceChanged(ChangeEventArgs e)
    {
        if (e is not null && e.Value is not null)
        {
            if (e.Value is Device)
            {
                var device = (Device)e.Value;
                SetSelectedDevice(device);
            }
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
