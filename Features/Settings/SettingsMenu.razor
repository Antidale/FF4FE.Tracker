<section id="settings-menu">
    <button popovertarget="settings-popover" class="settings-button nf nf-cod-settings_gear"></button>
    <dialog popover id="settings-popover" class="">
        <div>
            <div class="text-header">
                <h2>Settings</h2>
                <p>Settings automatically save</p>
            </div>
            <section class="input-grid">
                <section class="grid-row">
                    <div>Host</div>
                    <InputText @bind-Value="@AppState.Host"></InputText>
                </section>
                <section class="grid-row">
                    <div>Port</div>
                    <InputNumber @bind-Value="@AppState.Port" step="1"></InputNumber>
                </section>
                <section class="grid-row">
                    <div>Background Color</div>
                    <InputText @bind-Value="@AppState.BackgroundColor"></InputText>
                </section>
                <section class="grid-row">
                    <div>Text Color</div>
                    <InputText @bind-Value="@AppState.TextColor"></InputText>
                </section>
                <section class="grid-row">
                    <label for="@nameof(AppState.ShouldReadMetadata)">Read Metadata</label>
                    <InputCheckbox id="@nameof(AppState.ShouldReadMetadata)"
                                   @bind-Value="@AppState.ShouldReadMetadata" />
                </section>
                <section class="grid-row">
                    <label for="@nameof(AppState.ShowBaiganSpot)">Baigan Spot</label>
                    <InputCheckbox id="@nameof(AppState.ShowBaiganSpot)" @bind-Value="@AppState.ShowBaiganSpot" />
                </section>
                <section class="grid-row">
                    <label for="@nameof(AppState.ShowKnofree)">Knofree Info</label>
                    <InputCheckbox id="@nameof(AppState.ShowKnofree)" @bind-Value="@AppState.ShowKnofree" />
                </section>
                <section class="grid-row">
                    <div>Polling Interval (seconds)</div>
                    <InputNumber @bind-Value="@AppState.PollingFrequency" step="1" min="1" max="60"></InputNumber>
                </section>
            </section>
        </div>
    </dialog>
</section>

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();
}