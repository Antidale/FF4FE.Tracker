@using System.Text
@using Anti.Blazor.LocalStorage
@using FeTracker.Common.Enums
@using FeTracker.Common.RazorComponents
@using FeTracker.Sni.Services
@using Google.Protobuf
@using Grpc.Net.Client
@inject TrackerNotifier notifier;
@inject IJSRuntime JSRuntime;
@inject ILocalStorageService localStorage;

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Port = await localStorage.GetItemAsync<int?>("Port") ?? 8190;
        Host = await localStorage.GetItemAsync<string?>("Host") ?? "localhost";
        ShouldReadMetadata = await localStorage.GetItemAsync<bool?>(nameof(ShouldReadMetadata)) ?? true;
        PollingFrequency = await localStorage.GetItemAsync<int?>(nameof(PollingFrequency)) ?? 5;
        BackgroundColor = await localStorage.GetItemAsync<string?>(nameof(BackgroundColor)) ?? "#07273f";
        ShowBaiganSpot = await localStorage.GetItemAsync<bool?>(nameof(ShowBaiganSpot)) ?? true;
        ShowKnofree = await localStorage.GetItemAsync<bool?>(nameof(ShowKnofree)) ?? true;

        await base.OnInitializedAsync();
    }

    #region - Settings Properties -
    public string Host
    {
        get;
        set
        {
            field = value; StateHasChanged();
        }
    } = "localhost";

    public int Port
    {
        get;
        set
        {
            field = value;
            Task.Run(async () => await localStorage.SetItemAsync<int>(nameof(Port), value));
            StateHasChanged();
        }
    } = 8190;

    public bool ShouldReadMetadata
    {
        get;
        set
        {
            field = value;
            Task.Run(async () => await localStorage.SetItemAsync<bool>(nameof(ShouldReadMetadata), value));
        }
    } = true;

    public int PollingFrequency
    {
        get;
        set
        {
            if (field == value) { return; }
            if ((value <= 0 || value > 120)) { return; }
            field = value;
            Task.Run(async () => await localStorage.SetItemAsync<int>(nameof(PollingFrequency), value));
            notifier.PublishEvent(TrackerEvent.SettingUpdated, new(nameof(PollingFrequency), value));
        }
    } = 5;

    public string BackgroundColor
    {
        get;
        set
        {
            field = value;
            StateHasChanged();
            Task.Run(async () => localStorage.SetItemAsync<string>(nameof(BackgroundColor), value));
            Task.Run(async () => JSRuntime.InvokeVoidAsync("setBackground", value));
        }
    } = "#07273f";

    public string TextColor
    {
        get;
        set
        {
            field = value;
            StateHasChanged();
            Task.Run(async () => localStorage.SetItemAsync<string>(nameof(TextColor), value));
            Task.Run(async () => JSRuntime.InvokeVoidAsync("setTextColor", value));
        }
    } = "white";

    public bool ShowBaiganSpot
    {
        get;
        set
        {
            field = value;
            StateHasChanged();
            Task.Run(async () => localStorage.SetItemAsync<bool>(nameof(ShowBaiganSpot), value));
        }
    } = true;

    public bool ShowKnofree
    {
        get;
        set
        {
            field = value;
            StateHasChanged();
            Task.Run(async () => localStorage.SetItemAsync<bool>(nameof(ShowKnofree), value));
        }
    } = true;

    #endregion //Settings

    #region - SNI Connection Information -
    public string Uri
    {
        get;
        set { field = value; StateHasChanged(); }
    } = string.Empty;

    public string RomFileName
    {
        get;
        set
        {
            if (string.Equals(field, value)) { return; }
            field = value;
            StateHasChanged();
            if (IsFeHeader)
            {
                notifier.PublishEvent(TrackerEvent.RomUpdated, new(nameof(RomFileName), value));
            }

        }
    } = string.Empty;

    public string DeviceName
    {
        get;
        set { field = value; StateHasChanged(); }
    } = string.Empty;

    public string ConnectionError
    {
        get;
        set { field = value; StateHasChanged(); }
    } = string.Empty;

    public GrpcChannel? Channel => GrpcChannelService.GetChannel(Port, Host, true);

    public ByteString RomHeader00FFB0
    {
        get;
        set
        {
            if (field == value) { return; }
            field = value;
        }
    } = ByteString.Empty;

    public bool IsFeHeader
    {
        get
        {
            if (RomHeader00FFB0.Length < 0x31) return false;
            var evalString = Encoding.UTF8.GetString(RomHeader00FFB0.Span.Slice(0x10, 21));
            return evalString.Equals("FFIV: FREE ENTERPRISE");
        }
    }

    public string Version
    {
        get;
        set { field = value; }
    } = string.Empty;
    #endregion //SNI Connection Info

    public string Flags
    {
        get;
        set
        {
            field = value; StateHasChanged(); notifier.PublishEvent(TrackerEvent.SettingUpdated,
            new StatePropertyChangedArgs(nameof(Flags), true));
        }
    } = string.Empty;
}
