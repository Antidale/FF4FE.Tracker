@using FF4FE.Tracker.Features.Objectives
@using FeTracker.Common.Enums
@using FeTracker.Common.RegexHelpers
@using FeTracker.Sni.Classes
@using FeTracker.Sni.Models
@inject TrackerNotifier trackerNotifier

@if (_objectives.Any())
{
    <ul>
        @for (var i = 0; i < _objectives.Count; i++)
        {
            var isRequired = _hardRequiredObjectives.Contains(i);
            <Objective ObjectiveText="@_objectives[i]" IsRequired="isRequired" />
        }
    </ul>
    <p>@_completionText</p>
}
else
{
    <section class="group-grid">
        @foreach (var group in _groups)
        {
            <V5ObjectiveGroup Group="@group" />
        }
    </section>
}

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();
    private List<string> _objectives = [];
    private List<ObjectiveGroup> _groups = [];
    private string _completionText = string.Empty;
    private List<int> _hardRequiredObjectives = [];

    protected override void OnInitialized()
    {
        trackerNotifier.RegisterCallback(TrackerEvent.RomUpdated, new(this, GetMetadataAsync));
        
        base.OnInitialized();
    }

    public void OnFlagsUpdated(string flags)
    {
        if (_objectives.Count == 0) { return; }

        if (flags == "(hidden)")
        {
            _completionText = "Winning's a secret to everybody"; return;
        }
        
        var winCondition = FlagsRegexHelper.GetV4WinCondition(flags);
        _hardRequiredObjectives = [.. FlagsRegexHelper.GetRequiredObjectiveNumbers(flags).Select(x => x - 1)];
        var requiredCount = FlagsRegexHelper.GetRequiredObjectiveCount(flags);
        _completionText = $"Do {requiredCount} for {winCondition}";
    }

    private async Task GetMetadataAsync(StatePropertyChangedArgs args)
    {
        if (!AppState.ShouldReadMetadata
            || !AppState.IsFeHeader
            || AppState.RomFileName.Contains(".bin")
            || !string.IsNullOrWhiteSpace(AppState.ConnectionError))
        {
            return;
        }

        var seedDetail = await MetadataHelper.GetSeedDetails(AppState.Channel!, AppState.Uri);
        if (seedDetail.Success)
        {
            AppState.Flags = seedDetail.Data.Flags;
            _objectives = seedDetail.Data.Objectives;
            _groups = seedDetail.Data.ObjectiveGroups;
            AppState.Version = seedDetail.Data.Version;
            AppState.ConnectionError = string.Empty;
            OnFlagsUpdated(seedDetail.Data.Flags);
        }
        else
        {
            ResetMetadata(new(nameof(GetMetadataAsync), true));
        }
        StateHasChanged();
    }

    private void ResetMetadata(StatePropertyChangedArgs args)
    {
        AppState.Flags = string.Empty;
        _objectives = [];
        AppState.ConnectionError = string.Empty;
        StateHasChanged();
    }
}