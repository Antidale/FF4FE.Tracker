@inject TrackerNotifier notifier

<li>
    <input id="@ObjectiveText" type="checkbox" @onchange="OnChange" />
    <label for="@ObjectiveText">@ObjectiveText @if(IsRequired)
        {
            <span> (required)</span>
        }
    </label>
</li>

@code {

    [Parameter]
    public required string ObjectiveText { get; init; }

    [Parameter]
    public bool IsRequired { get; init; } = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void HandleNotification()
    {

    }

    private void OnChange(ChangeEventArgs args)
    {
        if (args is null || args.Value is null) { return; }
        Console.WriteLine(args?.Value?.GetType());
        
        notifier.PublishEvent(TrackerEvent.ObjectiveUpdated, new(ObjectiveText, args?.Value));
    }

}