@using System.Collections;
@using System.Text
@using System.Text.Json;
@using FeTracker.Common.Enums
@using FeTracker.Sni.Classes
@using FeTracker.Sni.Models
@using sni;
@using static sni.DeviceMemory
@inject TrackerNotifier trackerNotifier

@if (_objectives.Any())
{
    <ul>
        @foreach (var obj in _objectives)
        {
            <Objective ObjectiveText="@obj" />
        }
    
    </ul>
}
else
{
    <section class="group-grid">
        @foreach (var group in _groups)
        {
            <V5ObjectiveGroup Group="@group" />
        }
    </section>
}

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();

    private string _flags = string.Empty;
    private List<string> _objectives = [];
    private List<ObjectiveGroup> _groups = [];

    protected override void OnInitialized()
    {
        trackerNotifier.RegisterCallback(TrackerEvent.Reset, new(this, GetMetadataAsync));
        trackerNotifier.RegisterCallback(TrackerEvent.RomUpdated, new(this, GetMetadataAsync));
        base.OnInitialized();
    }

    private async Task GetMetadataAsync(StatePropertyChangedArgs args)
    {
        Console.WriteLine(args.PropertyName);
        if (!AppState.IsFeHeader
            || AppState.RomFileName.Contains(".bin")
            || !string.IsNullOrWhiteSpace(AppState.ConnectionError))
        {
            return;
        }

        if (args.PropertyName == nameof(AppState.RomFileName)
           || args.PropertyName == nameof(AppState.RomHeader00FFB0)
           || args.PropertyName == TrackerEvent.Reset.ToString())
        {
            _flags = "";
            _objectives = [];
            Console.WriteLine("cleared flags/objectives");
        }

        try
        {
            var memoryClient = new DeviceMemory.DeviceMemoryClient(AppState.Channel);
            var jsonDocLength = await GetMetadataDocLength(memoryClient);
            if (!jsonDocLength.Success)
            {
                //Given we're looking for the fe header, this shouldn't happen
                AppState.ConnectionError = "Unable to get metadata. Are you sure you have an FE seed loaded?";
            }

            var docString = await memoryClient.ReadByMemoryAddressAsync(AddressData.JsonDocument, AppState.Uri, jsonDocLength.Data);

            if (!docString.Success || docString.Data is null) { return; }

            var stuff = docString.Data.Response.Data.ToStringUtf8();
            var metadata = JsonSerializer.Deserialize<SeedMetadata>(docString.Data.Response.Data.ToStringUtf8());

            if (metadata is null) { return; }

            AppState.Version = metadata.Version;

            if (metadata.Version.StartsWith("v5"))
            {
                try
                {
                    _objectives = [];
                    Console.WriteLine(metadata.Objectives);
                    _groups = JsonSerializer.Deserialize<List<ObjectiveGroup>>(metadata.Objectives) ?? _groups;
                    foreach (var group in _groups)
                    {
                        foreach (var task in group.Tasks)
                        {
                            if (ObjectiveDictionary.TryGetObjectiveText(task.Objective, task.Threshold, out var returnValue))
                            {
                                task.Objective = returnValue;
                            }
                        }

                        foreach (var reward in group.Rewards)
                        {
                            var thingy = ObjectiveDictionary.GetReward(reward.Description);
                            thingy.ToString();
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex.Message);
                    Console.WriteLine(metadata.Objectives);
                    AppState.ConnectionError = "Couldn't Parse v5 Objective correctly";
                }


                //add in logic for handling compressed objectives
            }
            else if (metadata.Version.StartsWith("v0.4") || metadata.Version.StartsWith("v4."))
            {
                _groups = [];
                _objectives = JsonSerializer.Deserialize<List<string>>(metadata.Objectives) ?? _objectives;
            }

            @* //TODO: add eventual check for compressed metadata
            if (true)
            {
                
            } *@

            _flags = metadata.Flags ?? "no flags found. . . sadness";
            if (string.IsNullOrWhiteSpace(_flags))
            {
                _flags = "no flags found.... sadness";
            }
            Console.WriteLine("Set objectives");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            AppState.ConnectionError = "Error while trying to get metadata. Make sure you have an FE rom loaded.";
            Console.WriteLine(ex.Message);
        }
    }

    private async Task<Response<UInt32>> GetMetadataDocLength(DeviceMemoryClient client)
    {
        var response = await client.ReadByMemoryAddressAsync(AddressData.Metadata, AppState.Uri);

        if (response.Data is null || !response.Success)
        {
            return Response<UInt32>.SetError(response.ErrorMessage);
        }

        try
        {
            var jsonDocLength = BitConverter.ToUInt32(response.Data.Response.Data.ToArray(), 0);
            if (jsonDocLength == 0)
            {
                return Response<UInt32>.SetError("Unexpected metadata document length of 0 returned");
            }

            return Response<UInt32>.SetSuccess(jsonDocLength);
        }
        catch (Exception ex)
        {
            return Response<UInt32>.SetError(ex.Message);
        }
    }

    public async Task GetFoundKeyItems()
    {
        var channel = GrpcChannelService.GetChannel(AppState.Port, AppState.Host, true);
        var memoryClient = new DeviceMemory.DeviceMemoryClient(channel);
        var readMemoryRequest = new SingleReadMemoryRequest
        {
            Request = new ReadMemoryRequest
            {
                RequestAddress = AddressData.FOUND_KEY_ITEMS.Address,
                RequestAddressSpace = AddressSpace.FxPakPro,
                RequestMemoryMapping = MemoryMapping.LoRom,
                Size = AddressData.FOUND_KEY_ITEMS.Size
            },
            Uri = AppState.Uri,
        };

        var response = await memoryClient.SingleReadAsync(readMemoryRequest);

        var reponseData = response.Response.Data.ToByteArray();
        var stuff = new BitArray(reponseData);

        var stringBuilder = new StringBuilder();
        @* _testKi.Add("Found KI");
        for (var i = 0; i < 17; i++)
        {
            _testKi.Add($"Index {(KeyItem)i}, Value: {stuff[i]}");
        } *@

        readMemoryRequest.Request.RequestAddress = AddressData.USED_KEY_ITEMS.Address;
        readMemoryRequest.Request.Size = AddressData.USED_KEY_ITEMS.Size;
        response = await memoryClient.SingleReadAsync(readMemoryRequest);
        reponseData = response.Response.Data.ToByteArray();
        stuff = new BitArray(reponseData);
        @* _testKi.Add("Used KI");
        for (var i = 0; i < 17; i++)
        {
            _testKi.Add($"Index {(KeyItem)i}, Value: {stuff[i]}");
        } *@
    }

    private void ResetMetadata(StatePropertyChangedArgs args)
    {
        _flags = string.Empty;
        _objectives = [];
        AppState.ConnectionError = string.Empty;
        StateHasChanged();
    }
}