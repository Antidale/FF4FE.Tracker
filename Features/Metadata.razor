@using System.Collections;
@using System.Text
@using System.Text.Json;
@using FF4FE.Tracker.Models;
@using FeTracker.AutoTrack.Sni.Constants
@using FeTracker.AutoTrack.Sni.Services
@using FeTracker.Common.Constants
@using FeTracker.Common.Enums
@using FeTracker.Common.RazorComponents
@using sni;
@inject DeviceService DeviceService
@inject TrackerNotifier trackerNotifier

@if (!string.IsNullOrWhiteSpace(AppState.Uri))
{
    @if (!string.IsNullOrEmpty(AppState.DeviceName) && string.IsNullOrEmpty(_flags))
    {
        <button @onclick="GetMetadataAsync">Get Metadata</button>
    }

    <p>@ErrorMessage</p>

    @if (_objectives.Any())
    {
        <ul>
            @foreach (var obj in _objectives)
            {
                <Objective ObjectiveText="@obj" />
            }
        </ul>
    }
}

@code {
    [CascadingParameter]
    CascadingAppState AppState { get; set; } = new();
    private string? ErrorMessage;
    private string _flags = string.Empty;
    private List<string> _objectives = [];
    private Dictionary<KeyItem, bool> _keyItems = Enum.GetValues<KeyItem>().Cast<KeyItem>().ToDictionary(x => x, x =>
false);
    FieldsResponse? fieldsResponse = null;

    protected override void OnInitialized()
    {
        trackerNotifier.RegisterCallback(new(this, ResetMetadata));
        base.OnInitialized();
    }

    private async Task GetMetadataAsync()
    {
        var readMemoryRequest = new SingleReadMemoryRequest
        {
            Request = new ReadMemoryRequest
            {
                RequestAddress = AddressData.Metadata.Address,
                RequestAddressSpace = AddressSpace.FxPakPro,
                RequestMemoryMapping = MemoryMapping.Unknown,
                Size = AddressData.Metadata.Size
            },
            Uri = AppState.Uri,
        };

        SingleReadMemoryResponse response = new SingleReadMemoryResponse();
        var channel = GrpcChannelService.GetChannel(AppState.Port, AppState.Host, true);
        var infoClient = new DeviceInfo.DeviceInfoClient(channel);
        fieldsResponse = await infoClient.FetchFieldsAsync(
            request: new FieldsRequest()
            {
                Uri = AppState.Uri,
                Fields = {
                    Field.CoreName, Field.CorePlatform, Field.CoreVersion,
                    Field.DeviceName, Field.DeviceStatus, Field.DeviceVersion,
                    Field.RomFileName, Field.RomHashType, Field.RomHashValue
                }
            }
        );

        var memoryClient = new DeviceMemory.DeviceMemoryClient(channel);

        for (var count = 0; count <= 10; count++)
        {
            try
            {
                response = await memoryClient.SingleReadAsync(readMemoryRequest, deadline: DateTime.UtcNow.AddMilliseconds(100));
            }
            catch (Exception)
            {
                Thread.Sleep(100);
            }
        }

        try
        {
            var jsonDocLength = BitConverter.ToInt32(response.Response.Data.ToArray(), 0);

            var docString = await memoryClient.SingleReadAsync(new SingleReadMemoryRequest
            {
                Request = new ReadMemoryRequest
                {
                    RequestAddress = AddressData.JsonDocument.Address,
                    RequestAddressSpace = AddressSpace.FxPakPro,
                    RequestMemoryMapping = MemoryMapping.Unknown,
                    Size = (uint)jsonDocLength
                },
                Uri = AppState.Uri,
            });

            var stuff = docString.Response.Data.ToStringUtf8();
            var metadata = JsonSerializer.Deserialize<SeedMetadata>(docString.Response.Data.ToStringUtf8());
            Console.WriteLine(metadata?.Version ?? "no version found");

            if (!string.IsNullOrWhiteSpace(metadata?.Version) && metadata?.Version == "5.0.4")
            {
                Console.WriteLine("unzip it!");
            }

            _objectives = metadata?.Objectives ?? _objectives;
            _flags = metadata?.Flags ?? "no flags found. . . sadness";
            if (string.IsNullOrWhiteSpace(_flags))
            {
                _flags = "no flags found.... sadness";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error while trying to get metadata. Make sure you have an FE rom loaded.";
            Console.WriteLine(ex.Message);
        }

    }

    public async Task GetFoundKeyItems()
    {
        var channel = GrpcChannelService.GetChannel(AppState.Port, AppState.Host, true);
        var memoryClient = new DeviceMemory.DeviceMemoryClient(channel);

        var readMemoryRequest = new SingleReadMemoryRequest
        {
            Request = new ReadMemoryRequest
            {
                RequestAddress = AddressData.FOUND_KEY_ITEMS.Address,
                RequestAddressSpace = AddressSpace.FxPakPro,
                RequestMemoryMapping = MemoryMapping.LoRom,
                Size = AddressData.FOUND_KEY_ITEMS.Size
            },
            Uri = AppState.Uri,
        };

        var response = await memoryClient.SingleReadAsync(readMemoryRequest);

        var reponseData = response.Response.Data.ToByteArray();
        var stuff = new BitArray(reponseData);

        var stringBuilder = new StringBuilder();
        @* _testKi.Add("Found KI");
        for (var i = 0; i < 17; i++)
        {
            _testKi.Add($"Index {(KeyItem)i}, Value: {stuff[i]}");
        } *@

        readMemoryRequest.Request.RequestAddress = AddressData.USED_KEY_ITEMS.Address;
        readMemoryRequest.Request.Size = AddressData.USED_KEY_ITEMS.Size;
        response = await memoryClient.SingleReadAsync(readMemoryRequest);
        reponseData = response.Response.Data.ToByteArray();
        stuff = new BitArray(reponseData);
        @* _testKi.Add("Used KI");
        for (var i = 0; i < 17; i++)
        {
            _testKi.Add($"Index {(KeyItem)i}, Value: {stuff[i]}");
        } *@
    }

    private void ResetMetadata(StatePropertyChangedArgs args)
    {
        if (args.PropertyName != NotificationConstants.Reset) return;
        _flags = string.Empty;
        _objectives = [];
        StateHasChanged();
    }
}